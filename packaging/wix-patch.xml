<!-- CPACK_WIX_PATCH_FILE: adds the install's bin directory to the system
     PATH while gpusqz is installed. Windows Installer edits PATH itself,
     so a long PATH is neither truncated nor left behind on uninstall. -->
<CPackWiXPatch>
  <CPackWiXFragment Id="CM_CP_bin.gpusqz_refdec.exe">
    <Environment Id="GpusqzPath" Name="PATH" Value="[INSTALL_ROOT]bin"
                 Action="set" Part="last" System="yes" Permanent="no"/>
  </CPackWiXFragment>
</CPackWiXPatch>
